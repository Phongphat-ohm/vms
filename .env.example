# ==============================================================================
# Village Management System (VMS) — Environment Configuration Template (.env.example)
# สำเนาไฟล์นี้เป็น .env แล้วกรอกเฉพาะค่าหลัก ระบบมีค่า Default รองรับพร้อมใช้งานทันที
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การเชื่อมต่อฐานข้อมูล (Supabase Pooler & Direct Connection)
# ------------------------------------------------------------------------------
# Connection Pooler พอร์ต 6543 (สำหรับรันแอปลด Connection Overhead)
DATABASE_URL="postgresql://postgres.your-tenant-id:password@localhost:6543/postgres?pgbouncer=true"

# Direct Connection พอร์ต 5432 (สำหรับคำสั่ง migrate, db push และ seed)
DIRECT_URL="postgresql://postgres.your-tenant-id:password@localhost:5432/postgres"

# ------------------------------------------------------------------------------
# 2. การเชื่อมต่อ Supabase เวอร์ชันล่าสุด (Unified URL + Publishable & Secret Keys)
# ------------------------------------------------------------------------------
# Supabase Project URL (คลาวด์ เช่น https://xxxx.supabase.co หรือ Local เช่น http://localhost:8000)
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"

# Publishable Key สำหรับฝั่ง Browser/Public (sb_pub_... หรือ Legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_pub_example_key_here"

# Secret Key สำหรับฝั่ง Server-side เท่านั้น (sb_sec_... หรือ Legacy service_role key)
SUPABASE_SECRET_KEY="sb_sec_example_key_here"

# ------------------------------------------------------------------------------
# 3. ตัวแปรทางเลือก (Optional - หากไม่กรอก ระบบจะใช้ค่าเริ่มต้นที่ปลอดภัยให้โดยอัตโนมัติ)
# ------------------------------------------------------------------------------
# FIELD_ENCRYPTION_KEY=""
# BLIND_INDEX_PEPPER=""
# STORAGE_BUCKET_NAME="village-documents"
